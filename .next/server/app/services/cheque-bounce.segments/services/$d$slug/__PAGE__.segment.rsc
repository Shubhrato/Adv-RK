2:T660,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is the exact deadline to send a legal notice after a cheque bounces?","acceptedAnswer":{"@type":"Answer","text":"A statutory legal notice under Section 138 NI Act must be dispatched to the drawer within 30 calendar days from the date of receiving the bank dishonour return memo."}},{"@type":"Question","name":"What happens if the drawer ignores the 15-day cheque bounce notice?","acceptedAnswer":{"@type":"Answer","text":"If the drawer fails to clear the cheque payment within 15 days of receiving the legal notice, a criminal complaint is instituted before the Judicial Magistrate Court within the next 30 days."}},{"@type":"Question","name":"Can the court award interim compensation during a cheque bounce trial?","acceptedAnswer":{"@type":"Answer","text":"Yes, under Section 143A of the NI Act, the court may order the drawer to pay an interim compensation of up to 20% of the cheque amount to the complainant during trial."}},{"@type":"Question","name":"Is a cheque bounce case compoundable or settleable out of court?","acceptedAnswer":{"@type":"Answer","text":"Yes, Section 147 of the Negotiable Instruments Act classifies cheque bounce offences as compoundable, allowing parties to settle the matter through compromise at any trial stage."}},{"@type":"Question","name":"What is the maximum punishment awarded for cheque dishonour under Section 138?","acceptedAnswer":{"@type":"Answer","text":"The law provides for imprisonment for a term up to 2 years, or a monetary fine extending up to double the cheque amount, or both."}}]}0:{"buildId":"FH8UeKfY7251wkI4fw6lu","rsc":["$","$1","c",{"children":[["$","div",null,{"className":"page-animate","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"name\":\"Cheque Bounce (Section 138 NI Act)\",\"description\":\"Legal advocacy for Negot