f:["$","div",null,{"className":"page-animate","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"What to Do When a Cheque Bounces? Understanding Section 138 NI Act & 30-Day Legal Notice Rules\",\"image\":\"https://images.unsplash.com/photo-1450101499163-c8848c66ca85?auto=format&fit=crop&w=800&q=80\",\"datePublished\":\"2026-08-20\",\"dateModified\":\"2026-08-20\",\"author\":{\"@type\":\"LegalService\",\"name\":\"Advocate RK & Associates\",\"url\":\"https://advocaterk0788.in\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"Advocate RK & Associates\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://advocaterk0788.in/favicon.svg\"}},\"description\":\"Understand the mandatory 30-day legal demand notice timeframe, bank return memos, statutory remedies, and court proceedings under Section 138 NI Act.\"}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://advocaterk0788.in\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Legal Blog\",\"item\":\"https://advocaterk0788.in/blog\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"What to Do When a Cheque Bounces? Understanding Section 138 NI Act & 30-Day Legal Notice Rules\",\"item\":\"https://advocaterk0788.in/blog/cheque-bounce-legal-notice-guide\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Can legal action be taken if a security cheque bounces?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, if a security cheque was handed over in discharge of a pre-existing legally enforceable debt or liability, Section 138 NI Act applies.\"}},{\"@type\":\"Question\",\"name\":\"Where should a cheque bounce complaint be filed?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Following statutory amendments, the complaint is filed before the court having territorial jurisdiction over the bank branch where the payee maintains their account.\"}}]}"}}],["$","section",null,{"style":{"padding":"10rem 0 5rem","color":"white","textAlign":"center","backgroundImage":"linear-gradient(rgba(10, 25, 47, 0.88), rgba(10, 25, 47, 0.95)), url(\"https://images.unsplash.com/photo-1507679799987-c73779587ccf?auto=format&fit=crop&w=1920&q=80\")","backgroundSize":"cover","backgroundPosition":"center","backgroundColor":"var(--primary-color)"},"children":["$","div",null,{"className":"container","children":["$","$L17",null,{"children":[["$","div",null,{"style":{"fontSize":"0.95rem","marginBottom":"1.5rem","opacity":0.85},"children":[["$","$L18",null,{"href":"/","style":{"color":"var(--accent-color)","textDecoration":"none"},"children":"Home"}],["$","span",null,{"style":{"margin":"0 8px"},"children":"/"}],["$","$L18",null,{"href":"/blog","style":{"color":"var(--accent-color)","textDecoration":"none"},"children":"Legal Blog"}],["$","span",null,{"style":{"margin":"0 8px"},"children":"/"}],["$","span",null,{"style":{"color":"white"},"children":"Financial & Banking Law"}]]}],["$","div",null,{"style":{"display":"inline-block","backgroundColor":"var(--accent-color)","color":"var(--primary-color)","padding":"4px 16px","borderRadius":"20px","fontSize":"0.85rem","fontWeight":700,"marginBottom":"1.5rem","textTransform":"uppercase"},"children":"Financial & Banking Law"}],["$","h1",null,{"style":{"fontSize":"2.8rem","marginBottom":"1.5rem","color":"white","lineHeight":1.3,"maxWidth":"900px","margin":"0 auto 1.5rem"},"children":"What to Do When a Cheque Bounces? Understanding Section 138 NI Act & 30-Day Legal Notice Rules"}],["$","div",null,{"style":{"fontSize":"0.95rem","opacity":0.9,"display":"flex","gap":"20px","justifyContent":"center","flexWrap":"wrap"},"children":["$L19","$L1a","$L1b"]}]]}]}]}],"$L1c"]}]
